# ==============================================================================
# MEDPULSE HOSPITAL MANAGEMENT SYSTEM (HMS) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your valid credentials.
#
# IMPORTANT:
# - Use the Supabase Project URL and anon / publishable key in the frontend.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY or database passwords in client code.
# - If these variables are not configured, the HMS runs in a graceful 'Setup Mode'
#   with clearly labeled development placeholders.
# ==============================================================================

# Supabase Project API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Public Key
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Application Environment Mode (development | staging | production)
VITE_APP_ENV=development

# Optional Application Brand Details
VITE_APP_NAME="MedPulse Hospital Management System"
VITE_APP_VERSION="1.0.0"
